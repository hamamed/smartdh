<section class="py-4 py-lg-5">
  <div class="container" style="max-width: 640px;">
    <div class="d-flex align-items-center gap-2 mb-4">
      <a href="/send" class="btn btn-outline-secondary btn-icon rounded-circle"><i data-lucide="arrow-left"></i></a>
      <h3 class="fw-bold mb-0 d-flex align-items-center gap-2"><i data-lucide="inbox" class="text-primary"></i><%= t('rcv_title') %></h3>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
          <span class="text-muted small"><%= t('rcv_total', { amount: money(received.reduce((s, r) => s + r.amount, 0)) }) %></span>
          <% if (received.length) { %>
            <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" onclick="window.print()"><i data-lucide="printer"></i><%= t('rcv_pdf') %></button>
          <% } %>
        </div>

        <% if (!received.length) { %>
          <p class="text-muted small mb-0 d-flex align-items-center gap-1"><i data-lucide="inbox"></i><%= t('rcv_empty') %></p>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% received.forEach(r => { %>
              <div class="list-group-item px-0 d-flex align-items-center gap-2 bg-transparent">
                <span class="tile-icon ti-mint flex-shrink-0" style="width:38px;height:38px;font-size:.95rem"><i data-lucide="inbox"></i></span>
                <div class="flex-grow-1 min-w-0">
                  <div class="fw-semibold small text-truncate"><%= t('rcv_from', { name: r.fromName }) %></div>
                  <div class="fw-bold small text-success"><%= money(r.amount) %></div>
                  <div class="text-muted" style="font-size:.72rem"><span data-ago="<%= r.createdAt %>" title="<%= new Date(r.createdAt).toLocaleString() %>"><%= timeAgo(r.createdAt) %></span> · <%= new Date(r.createdAt).toLocaleDateString() %></div>
                </div>
                <a href="/invoice/transfer/<%= r.id %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary btn-icon flex-shrink-0 d-print-none" style="width:30px;height:30px" title="<%= t('inv_title') %>"><i data-lucide="file-text"></i></a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
