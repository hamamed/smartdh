<section class="lp-hero py-5">
  <div class="container" style="max-width: 720px;">
    <div class="text-center">
      <img src="/icons/icon-192.png?v=<%= assetV %>" alt="<%= settings.siteName %>" width="88" height="88"
           style="border-radius:22px;box-shadow:var(--shadow-md)">
      <h1 class="fw-bold mt-3 mb-2"><%= t('dl_title') %></h1>
      <p class="text-muted mb-4 mx-auto" style="max-width:44ch"><%= t('dl_sub') %></p>

      <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center mb-2">
        <!-- Shown only when the browser reports the app is installable -->
        <button type="button" data-pwa-install hidden class="btn btn-primary btn-lg px-4 d-inline-flex align-items-center justify-content-center gap-2">
          <i data-lucide="download"></i><%= t('dl_install') %>
        </button>
        <% if (apkUrl) { %>
          <a href="<%= apkUrl %>" class="btn btn-success btn-lg px-4 d-inline-flex align-items-center justify-content-center gap-2">
            <i data-lucide="smartphone"></i><%= t('dl_apk') %>
          </a>
        <% } %>
        <a href="/dashboard" class="btn btn-outline-secondary btn-lg px-4 d-inline-flex align-items-center justify-content-center gap-2">
          <i data-lucide="external-link"></i><%= t('dl_open') %>
        </a>
      </div>
    </div>

    <!-- Features -->
    <div class="row g-3 mt-3">
      <% [['zap','dl_f1'], ['smartphone','dl_f2'], ['wifi-off','dl_f3']].forEach(([icon, key]) => { %>
        <div class="col-sm-4">
          <div class="lp-card text-center p-4 h-100">
            <span class="tile-icon ti-mint mx-auto mb-2" style="width:52px;height:52px;font-size:1.35rem"><i data-lucide="<%= icon %>"></i></span>
            <div class="fw-semibold small"><%= t(key) %></div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- How to install -->
    <div class="card border-0 shadow-sm rounded-4 mt-4">
      <div class="card-body">
        <h6 class="fw-bold mb-3 d-flex align-items-center gap-2"><i data-lucide="help-circle" class="text-primary"></i><%= t('dl_how') %></h6>
        <div class="d-flex align-items-start gap-3 mb-3">
          <span class="tile-icon ti-sky flex-shrink-0" style="width:44px;height:44px;font-size:1.1rem"><i data-lucide="smartphone"></i></span>
          <div>
            <div class="fw-semibold"><%= t('dl_android') %></div>
            <div class="text-muted small"><%= t('dl_android_d') %></div>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3">
          <span class="tile-icon ti-lilac flex-shrink-0" style="width:44px;height:44px;font-size:1.1rem"><i data-lucide="apple"></i></span>
          <div>
            <div class="fw-semibold"><%= t('dl_ios') %></div>
            <div class="text-muted small"><%= t('dl_ios_d') %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
