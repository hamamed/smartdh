<% const tg = settings.telegram || {}; %>
<section class="py-4 py-lg-5">
  <div class="container" style="max-width: 640px;">
    <%- include('_head', { heading: t('set_telegram_t'), back: '/admin' }) %>
    <% if (ok) { %><div class="alert alert-success py-2 d-flex align-items-center gap-1"><i data-lucide="check"></i><%= t('profile_saved') %></div><% } %>
    <% if (test === 'ok') { %><div class="alert alert-success py-2 d-flex align-items-center gap-1"><i data-lucide="check"></i><%= t('tg_test_ok') %></div><% } %>
    <% if (test === 'fail') { %><div class="alert alert-danger py-2 d-flex align-items-center gap-1"><i data-lucide="alert-triangle"></i><%= t('tg_test_fail') %></div><% } %>

    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-body">
        <h6 class="fw-bold mb-1 d-flex align-items-center gap-2"><i data-lucide="send" class="text-primary"></i><%= t('set_telegram_t') %></h6>
        <p class="text-muted small mb-3"><%= t('set_telegram_d') %></p>

        <ol class="small text-muted mb-3 ps-3">
          <li><%= t('tg_help_1') %></li>
          <li><%= t('tg_help_2') %></li>
          <li><%= t('tg_help_3') %></li>
        </ol>

        <form action="/admin/settings/telegram" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" name="enabled" id="tgEnabled" value="1" <%= tg.enabled ? 'checked' : '' %>>
            <label class="form-check-label fw-semibold" for="tgEnabled"><%= t('tg_enable') %></label>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold"><%= t('tg_token') %></label>
            <input name="botToken" class="form-control" dir="ltr" placeholder="123456789:AA..." value="<%= tg.botToken || '' %>">
            <% if (envToken) { %><div class="form-text"><%= t('tg_env_set') %></div><% } %>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold"><%= t('tg_chat') %></label>
            <input name="chatId" class="form-control" dir="ltr" placeholder="-1001234567890" value="<%= tg.chatId || '' %>">
            <% if (envChat) { %><div class="form-text"><%= t('tg_env_set') %></div><% } %>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary d-inline-flex align-items-center gap-1"><i data-lucide="save"></i><%= t('btn_save') %></button>
            <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-1" formaction="/admin/settings/telegram/test" formmethod="post"><i data-lucide="send"></i><%= t('tg_test_btn') %></button>
          </div>
        </form>
      </div>
    </div>

    <div class="alert alert-secondary small mt-3 d-flex align-items-start gap-2">
      <i data-lucide="info"></i><span><%= t('tg_events_note') %></span>
    </div>
  </div>
</section>
