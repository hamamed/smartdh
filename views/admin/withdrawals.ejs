<section class="py-4 py-lg-5">
  <div class="container">
    <%- include('_head', { heading: t('tab_withdrawals') }) %>

    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-body">
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
          <form method="get" action="/admin/withdrawals" class="d-flex gap-2" style="max-width:320px">
            <% if (per !== 10) { %><input type="hidden" name="per" value="<%= per %>"><% } %>
            <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
            <div class="input-group input-group-sm">
              <span class="input-group-text"><i data-lucide="search"></i></span>
              <input name="q" class="form-control" placeholder="<%= t('search_player') %>" value="<%= q %>">
            </div>
            <button class="btn btn-sm btn-primary"><%= t('btn_search') %></button>
          </form>
          <div class="ms-auto d-flex gap-2 flex-wrap align-items-center">
            <%- include('_filters', {
                  keep: (per !== 10 ? '&per=' + per : ''), base: '/admin/withdrawals', current: status, q: q,
                  options: [
                    { value: '',         label: t('filter_all'),  count: (statusCounts.pending||0)+(statusCounts.paid||0)+(statusCounts.rejected||0) },
                    { value: 'pending',  label: t('st_pending'),  count: statusCounts.pending  || 0, danger: true },
                    { value: 'paid',     label: t('st_paid'),     count: statusCounts.paid     || 0 },
                    { value: 'rejected', label: t('st_rejected'), count: statusCounts.rejected || 0 }
                  ]
                }) %>
            <a href="/admin/export/withdrawals.csv" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"><i data-lucide="download"></i><%= t('export_withdrawals') %></a>
          </div>
        </div>
        <% if (withdrawals.length === 0) { %>
          <p class="text-muted mb-0"><%= t('no_results') %></p>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% withdrawals.forEach(w => { const wc = w.status==='paid'?'success':(w.status==='rejected'?'danger':'warning'); %>
              <div class="list-group-item px-0 d-flex align-items-start gap-2 bg-transparent">
                <a href="/admin/invoice/withdraw/<%= w.id %>" target="_blank" rel="noopener" class="tile-icon ti-coral flex-shrink-0" style="width:38px;height:38px;font-size:.95rem" title="<%= t('inv_title') %>"><i data-lucide="arrow-up-circle"></i></a>
                <div class="flex-grow-1 min-w-0">
                  <a href="/admin/users/<%= w.userId %>" class="fw-semibold small text-truncate d-block text-reset text-decoration-none"><%= w.userName %></a>
                  <div class="fw-bold small text-danger"><%= money(w.amount) %></div>
                  <div class="d-flex align-items-center gap-2 mt-1" style="font-size:.72rem">
                    <span class="badge bg-<%= wc %>-subtle text-<%= wc %> text-capitalize"><%= w.status %></span>
                    <span class="text-muted text-truncate"><%= w.fromLabel || w.from %> · <span data-ago="<%= w.createdAt %>" title="<%= new Date(w.createdAt).toLocaleString() %>"><%= timeAgo(w.createdAt) %></span></span>
                  </div>
                  <% if (w.payoutName || w.payoutAccount) { %>
                    <div class="d-flex align-items-center gap-1 mt-1 p-2 rounded-3 bg-body-secondary" style="font-size:.72rem">
                      <i data-lucide="<%= w.method === 'bank' ? 'landmark' : 'wallet' %>" style="width:.9em;height:.9em"></i>
                      <span class="fw-semibold"><%= w.payoutName || '' %></span>
                      <span class="text-muted" dir="ltr" style="word-break:break-all"><%= w.payoutAccount || '' %></span>
                    </div>
                  <% } %>
                </div>
                <% if (w.status === 'pending') { %>
                  <div class="d-flex gap-1 flex-shrink-0">
                    <form action="/admin/withdraw/<%= w.id %>/approve" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-success btn-icon" style="width:32px;height:32px" title="<%= t('btn_markpaid') %>"><i data-lucide="check"></i></button></form>
                    <form action="/admin/withdraw/<%= w.id %>/reject" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline-danger btn-icon" style="width:32px;height:32px" title="<%= t('st_rejected') %>"><i data-lucide="x"></i></button></form>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
          <% const kept = (status ? '&status=' + status : '') + (q ? '&q=' + encodeURIComponent(q) : ''); %>
          <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2">
            <span class="small text-muted"><%= t('showing_n', { shown: withdrawals.length, total: total }) %></span>
            <%- include('_perpage', { base: '/admin/withdrawals', per: per, options: perOptions, qs: kept }) %>
            <%- include('_pager', { base: '/admin/withdrawals', page: page, pages: pages, qs: kept + '&per=' + per }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
